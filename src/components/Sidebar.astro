---
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

const docs = await getCollection('docs', ({ data }) => !data.draft);

const sectionMeta: Record<string, { label: string; order: number }> = {
  'start-here': { label: 'Start Here', order: 0 },
  'the-api': { label: 'The API', order: 1 },
  prompting: { label: 'Prompting', order: 2 },
  retrieval: { label: 'RAG (Retrieval Augmented Generation)', order: 3 },
  agents: { label: 'Agents', order: 4 },
  'claude-code': { label: 'Claude Code', order: 5 },
  mcp: { label: 'MCP', order: 6 },
  production: { label: 'Production', order: 7 },
  recipes: { label: 'Recipes', order: 8 },
  reference: { label: 'Reference', order: 9 },
};

// Group docs by section, sorted
const sections = Object.entries(sectionMeta)
  .sort(([, a], [, b]) => a.order - b.order)
  .map(([key, meta]) => ({
    key,
    label: meta.label,
    pages: docs
      .filter((d) => d.data.section === key)
      .sort((a, b) => a.data.order - b.data.order),
  }))
  .filter((s) => s.pages.length > 0);

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<nav class="sidebar w-64 shrink-0 border-r border-gray-200 bg-gray-950 text-gray-300" aria-label="Main navigation">
  <div class="sticky top-0 flex h-screen flex-col overflow-y-auto px-4 py-6">
    <a href="/" class="mb-8 flex items-center gap-2 text-white no-underline">
      <svg class="h-7 w-7 text-indigo-400" viewBox="0 0 24 24" fill="currentColor">
        <!-- Claude sparkle — organic irregular rays -->
        <path d="M12 1.5c-.3 0-.6 3.5-.8 5.5-.1 1.2-.1 2.5.8 2.5s.9-1.3.8-2.5c-.2-2-.5-5.5-.8-5.5z" />
        <path d="M12 22.5c.3 0 .6-3.5.8-5.5.1-1.2.1-2.5-.8-2.5s-.9 1.3-.8 2.5c.2 2 .5 5.5.8 5.5z" />
        <path d="M1.5 12c0 .3 3.5.6 5.5.8 1.2.1 2.5.1 2.5-.8s-1.3-.9-2.5-.8c-2 .2-5.5.5-5.5.8z" />
        <path d="M22.5 12c0-.3-3.5-.6-5.5-.8-1.2-.1-2.5-.1-2.5.8s1.3.9 2.5.8c2-.2 5.5-.5 5.5-.8z" />
        <path d="M4.2 4.8c-.2.2 2.5 2.8 4 4.2.9.8 2 1.4 2.4 1s-.5-1.6-1.4-2.4c-1.4-1.2-4.8-3-5-2.8z" />
        <path d="M19.8 19.2c.2-.2-2.5-2.8-4-4.2-.9-.8-2-1.4-2.4-1s.5 1.6 1.4 2.4c1.4 1.2 4.8 3 5 2.8z" />
        <path d="M19.2 4.2c.2.2-2.2 3.2-3.6 4.6-.8.9-1.8 1.2-2 .8s.6-1.4 1.4-2.2c1.2-1.4 4-3.4 4.2-3.2z" />
        <path d="M4.8 19.8c-.2-.2 2.2-3.2 3.6-4.6.8-.9 1.8-1.2 2-.8s-.6 1.4-1.4 2.2c-1.2 1.4-4 3.4-4.2 3.2z" />
        <path d="M7 2.8c-.2.1 1 3.8 2 5.6.5 1 1.3 1.8 1.7 1.4s-.1-1.5-.7-2.5c-1-1.6-2.8-4.6-3-4.5z" />
        <path d="M17 21.2c.2-.1-1-3.8-2-5.6-.5-1-1.3-1.8-1.7-1.4s.1 1.5.7 2.5c1 1.6 2.8 4.6 3 4.5z" />
        <path d="M2.5 7.5c-.1.2 3.6 1.3 5.4 2 1 .4 2 .6 2.2.1s-1-.9-2-1.4c-1.8-.8-5.5-1-5.6-.7z" />
        <path d="M21.5 16.5c.1-.2-3.6-1.3-5.4-2-1-.4-2-.6-2.2-.1s1 .9 2 1.4c1.8.8 5.5 1 5.6.7z" />
        <path d="M21 7c.1.2-3.2 1.8-5 2.8-1 .5-2 .8-2.2.4s.8-1.2 1.8-1.8c1.5-1 5.3-1.6 5.4-1.4z" />
        <path d="M3 17c-.1-.2 3.2-1.8 5-2.8 1-.5 2-.8 2.2-.4s-.8 1.2-1.8 1.8c-1.5 1-5.3 1.6-5.4 1.4z" />
        <circle cx="12" cy="12" r="2.2" />
      </svg>
      <span class="text-lg font-semibold tracking-tight">{SITE.title}</span>
    </a>

    {sections.map((section) => (
      <div class="mb-6">
        <h3 class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-gray-500">
          {section.label}
        </h3>
        <ul class="space-y-0.5">
          {section.pages.map((page) => {
            const href = `/${page.id}`;
            const isActive = currentPath === href;
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    'block rounded-md px-2 py-1.5 text-sm transition-colors no-underline',
                    isActive
                      ? 'bg-indigo-500/10 font-medium text-indigo-400'
                      : 'text-gray-400 hover:bg-gray-800 hover:text-gray-200',
                  ]}
                >
                  {page.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</nav>
