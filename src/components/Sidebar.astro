---
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

const docs = await getCollection('docs', ({ data }) => !data.draft);

const sectionMeta: Record<string, { label: string; order: number }> = {
  'start-here': { label: 'Start Here', order: 0 },
  'the-api': { label: 'The API', order: 1 },
  prompting: { label: 'Prompting', order: 2 },
  retrieval: { label: 'RAG (Retrieval Augmented Generation)', order: 3 },
  agents: { label: 'Agents', order: 4 },
  'claude-code': { label: 'Claude Code', order: 5 },
  mcp: { label: 'MCP', order: 6 },
  production: { label: 'Production', order: 7 },
  scenarios: { label: 'Scenarios', order: 8 },
  reference: { label: 'Reference', order: 9 },
};

// Group docs by section, sorted
const sections = Object.entries(sectionMeta)
  .sort(([, a], [, b]) => a.order - b.order)
  .map(([key, meta]) => ({
    key,
    label: meta.label,
    pages: docs
      .filter((d) => d.data.section === key)
      .sort((a, b) => a.data.order - b.data.order),
  }))
  .filter((s) => s.pages.length > 0);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<nav class="sidebar w-64 shrink-0 border-r border-gray-800/50 bg-gray-950 text-gray-300" aria-label="Main navigation">
  <div class="sticky top-0 flex h-screen flex-col overflow-y-auto px-4 py-6">
    <a href={`${base}/`} class="mb-8 flex items-center gap-2 text-white no-underline">
      <svg class="h-7 w-7" viewBox="0 0 28 24" fill="none">
        <!-- Left curly bracket -->
        <path d="M8 4C5.5 4 4 5.5 4 7.5v2.5c0 1.5-1 2-2 2 1 0 2 .5 2 2v2.5C4 18.5 5.5 20 8 20" stroke="currentColor" class="text-indigo-400" stroke-width="1.8" stroke-linecap="round" fill="none" />
        <!-- Right curly bracket -->
        <path d="M20 4c2.5 0 4 1.5 4 3.5v2.5c0 1.5 1 2 2 2-1 0-2 .5-2 2v2.5c0 2-1.5 3.5-4 3.5" stroke="currentColor" class="text-indigo-400" stroke-width="1.8" stroke-linecap="round" fill="none" />
        <!-- Center asterisk -->
        <line x1="14" y1="6.5" x2="14" y2="17.5" stroke="currentColor" class="text-indigo-400" stroke-width="1.8" stroke-linecap="round" />
        <line x1="9.2" y1="9.2" x2="18.8" y2="14.8" stroke="currentColor" class="text-indigo-400" stroke-width="1.8" stroke-linecap="round" />
        <line x1="9.2" y1="14.8" x2="18.8" y2="9.2" stroke="currentColor" class="text-indigo-400" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <span class="text-lg font-semibold tracking-tight">{SITE.title}</span>
    </a>

    {sections.map((section) => (
      <div class="mb-6">
        <h3 class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-gray-500">
          {section.label}
        </h3>
        <ul class="space-y-0.5">
          {section.pages.map((page) => {
            const href = `${base}/${page.id}`;
            const isActive = currentPath === href;
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    'block rounded-md px-2 py-1.5 text-sm transition-colors no-underline',
                    isActive
                      ? 'bg-indigo-500/10 font-medium text-indigo-400'
                      : 'text-gray-400 hover:bg-gray-800 hover:text-gray-200',
                  ]}
                >
                  {page.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</nav>
