---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileMenuButton from '../components/MobileMenuButton.astro';

interface HeadingInfo {
  depth: number;
  slug: string;
  text: string;
}

interface PageLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  section: string;
  headings?: HeadingInfo[];
  prevPage?: PageLink | null;
  nextPage?: PageLink | null;
}

const sectionLabels: Record<string, string> = {
  'start-here': 'Start Here',
  'the-api': 'The API',
  prompting: 'Prompting',
  retrieval: 'RAG (Retrieval Augmented Generation)',
  agents: 'Agents',
  mcp: 'MCP',
  production: 'Production',
  recipes: 'Recipes',
  reference: 'Reference',
};

const { title, description, section, headings = [], prevPage, nextPage } = Astro.props;
const sectionLabel = sectionLabels[section] ?? section.replace(/-/g, ' ');

// TOC: show h2 headings when there are 2+
const excludeFromToc = new Set(['related', 'quick-reference']);
const tocHeadings = headings.filter((h) => h.depth === 2 && !excludeFromToc.has(h.slug));
const showToc = tocHeadings.length >= 2;
---

<BaseLayout title={`${title} — Solutions Architecture`}>
  <div class="flex min-h-screen">
    <Sidebar />
    <main class="min-w-0 flex-1">
      <div class="mx-auto max-w-3xl px-8 py-16 lg:px-12">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-1.5 text-sm" aria-label="Breadcrumb">
          <a href="/" class="text-gray-500 hover:text-gray-700 dark:text-gray-500 dark:hover:text-gray-300">Home</a>
          <span class="text-gray-400 dark:text-gray-600">/</span>
          <span class="font-medium text-indigo-700 dark:text-indigo-400">{sectionLabel}</span>
        </nav>

        <h1 class="mt-3 text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
          {title}
        </h1>
        <p class="mt-4 text-lg text-gray-700 dark:text-gray-400">{description}</p>

        <!-- On this page TOC -->
        {showToc && (
          <nav class="mt-8 rounded-lg border border-gray-200 bg-gray-50 px-5 py-4 dark:border-gray-800 dark:bg-gray-900" aria-label="On this page">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">On this page</p>
            <ul class="mt-2 space-y-1">
              {tocHeadings.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class="text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <article class="prose prose-lg prose-indigo mt-12 max-w-none">
          <slot />
        </article>

        <!-- Prev / Next navigation -->
        {(prevPage || nextPage) && (
          <nav class="mt-16 flex items-stretch gap-4 border-t border-gray-200 pt-8 dark:border-gray-800" aria-label="Page navigation">
            {prevPage ? (
              <a
                href={prevPage.href}
                class="group flex flex-1 flex-col rounded-lg border border-gray-200 px-5 py-4 text-left no-underline transition-colors hover:border-indigo-300 hover:bg-indigo-50 dark:border-gray-700 dark:hover:border-indigo-600 dark:hover:bg-indigo-950"
              >
                <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Previous</span>
                <span class="mt-1 text-sm font-medium text-gray-900 group-hover:text-indigo-700 dark:text-gray-200 dark:group-hover:text-indigo-400">&larr; {prevPage.title}</span>
              </a>
            ) : <div class="flex-1" />}
            {nextPage ? (
              <a
                href={nextPage.href}
                class="group flex flex-1 flex-col rounded-lg border border-gray-200 px-5 py-4 text-right no-underline transition-colors hover:border-indigo-300 hover:bg-indigo-50 dark:border-gray-700 dark:hover:border-indigo-600 dark:hover:bg-indigo-950"
              >
                <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Next</span>
                <span class="mt-1 text-sm font-medium text-gray-900 group-hover:text-indigo-700 dark:text-gray-200 dark:group-hover:text-indigo-400">{nextPage.title} &rarr;</span>
              </a>
            ) : <div class="flex-1" />}
          </nav>
        )}
      </div>
    </main>
    <MobileMenuButton />
  </div>
</BaseLayout>

<style is:global>
  .mermaid {
    display: flex;
    justify-content: center;
    margin: 1.5em 0;
    max-width: 100%;
    overflow-x: auto;
  }
  .mermaid svg {
    max-width: 100%;
    height: auto;
  }
  /* Prevent prose typography styles from interfering with Mermaid SVGs */
  .prose .mermaid text {
    font-size: inherit;
    line-height: normal;
    color: inherit;
  }
  .prose .mermaid a {
    text-decoration: none;
    color: inherit;
  }
  .prose .mermaid pre,
  .prose .mermaid code {
    background: none;
    padding: 0;
    border: 0;
    font-size: inherit;
  }
</style>
