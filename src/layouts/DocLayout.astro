---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileMenuButton from '../components/MobileMenuButton.astro';

interface Props {
  title: string;
  description: string;
  section: string;
}

const { title, description, section } = Astro.props;
const sectionLabel = section.replace(/-/g, ' ');
---

<BaseLayout title={`${title} — Solutions Architecture`}>
  <div class="flex min-h-screen">
    <Sidebar />
    <main class="min-w-0 flex-1">
      <div class="mx-auto max-w-3xl px-8 py-16 lg:px-12">
        <p class="text-sm font-medium uppercase tracking-wide text-indigo-800 dark:text-indigo-400">
          {sectionLabel}
        </p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
          {title}
        </h1>
        <p class="mt-4 text-lg text-gray-700 dark:text-gray-400">{description}</p>
        <article class="prose prose-lg prose-indigo mt-12 max-w-none">
          <slot />
        </article>
      </div>
    </main>
    <MobileMenuButton />
  </div>
</BaseLayout>

<style is:global>
  .mermaid {
    display: flex;
    justify-content: center;
    margin: 1.5em 0;
    max-width: 100%;
    overflow-x: auto;
  }
  .mermaid svg {
    max-width: 100%;
    height: auto;
  }
  /* Prevent prose typography styles from interfering with Mermaid SVGs */
  .prose .mermaid text {
    font-size: inherit;
    line-height: normal;
    color: inherit;
  }
  .prose .mermaid a {
    text-decoration: none;
    color: inherit;
  }
  .prose .mermaid pre,
  .prose .mermaid code {
    background: none;
    padding: 0;
    border: 0;
    font-size: inherit;
  }
</style>
