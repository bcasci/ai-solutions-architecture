---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileMenuButton from '../components/MobileMenuButton.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface SectionPage {
  title: string;
  href: string;
  isCurrent: boolean;
}

interface PageLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  section: string;
  sectionPages?: SectionPage[];
  prevPage?: PageLink | null;
  nextPage?: PageLink | null;
}

const sectionLabels: Record<string, string> = {
  'start-here': 'Start Here',
  'the-api': 'The API',
  prompting: 'Prompting',
  retrieval: 'RAG (Retrieval Augmented Generation)',
  agents: 'Agents',
  'claude-code': 'Claude Code',
  mcp: 'MCP',
  production: 'Production',
  scenarios: 'Scenarios',
  reference: 'Reference',
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, description, section, sectionPages = [], prevPage, nextPage } = Astro.props;
const sectionLabel = sectionLabels[section] ?? section.replace(/-/g, ' ');
const showSectionNav = sectionPages.length >= 2;
---

<BaseLayout title={`${title} — ${SITE.title}`} description={description} canonicalPath={Astro.url.pathname}>
  <div class="flex min-h-screen">
    <Sidebar />
    <main class="min-w-0 flex-1">
      <div class="mx-auto max-w-3xl px-8 py-16 lg:px-12">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-1.5 text-sm" aria-label="Breadcrumb">
          <a href={`${base}/`} class="text-gray-500 hover:text-gray-700 dark:text-gray-500 dark:hover:text-gray-300">Home</a>
          <span class="text-gray-400 dark:text-gray-600">/</span>
          <span class="font-medium text-indigo-700 dark:text-indigo-400">{sectionLabel}</span>
        </nav>

        <h1 class="mt-3 text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
          {title}
        </h1>
        <p class="mt-4 text-lg text-gray-700 dark:text-gray-400">{description}</p>

        <!-- Section navigation -->
        {showSectionNav && (
          <nav class="mt-8 rounded-lg border border-gray-200/80 bg-gray-50 px-5 py-4 dark:border-gray-800/80 dark:bg-gray-900/50" aria-label="Section contents">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">In this section</p>
            <ul class="mt-2 space-y-1">
              {sectionPages.map((p) => (
                <li class="flex items-center gap-2">
                  {p.isCurrent ? (
                    <span class="text-sm font-medium text-gray-900 dark:text-gray-100">
                      {p.title}
                    </span>
                  ) : (
                    <a
                      href={p.href}
                      class="text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
                    >
                      {p.title}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        )}

        <article class="prose prose-lg prose-indigo mt-12 max-w-none">
          <slot />
        </article>

        <!-- Prev / Next navigation -->
        {(prevPage || nextPage) && (
          <nav class="mt-16 flex items-stretch gap-4 border-t border-gray-200/60 pt-8 dark:border-gray-800/60" aria-label="Page navigation">
            {prevPage ? (
              <a
                href={prevPage.href}
                class="group flex flex-1 flex-col rounded-lg border border-gray-200/80 px-5 py-4 text-left no-underline transition-all hover:border-indigo-300 hover:bg-indigo-50 hover:-translate-y-0.5 hover:shadow-sm dark:border-gray-700/80 dark:hover:border-indigo-600 dark:hover:bg-indigo-950"
              >
                <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Previous</span>
                <span class="mt-1 text-sm font-medium text-gray-900 group-hover:text-indigo-700 dark:text-gray-200 dark:group-hover:text-indigo-400">&larr; {prevPage.title}</span>
              </a>
            ) : <div class="flex-1" />}
            {nextPage ? (
              <a
                href={nextPage.href}
                class="group flex flex-1 flex-col rounded-lg border border-gray-200/80 px-5 py-4 text-right no-underline transition-all hover:border-indigo-300 hover:bg-indigo-50 hover:-translate-y-0.5 hover:shadow-sm dark:border-gray-700/80 dark:hover:border-indigo-600 dark:hover:bg-indigo-950"
              >
                <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Next</span>
                <span class="mt-1 text-sm font-medium text-gray-900 group-hover:text-indigo-700 dark:text-gray-200 dark:group-hover:text-indigo-400">{nextPage.title} &rarr;</span>
              </a>
            ) : <div class="flex-1" />}
          </nav>
        )}
      </div>
      <Footer />
    </main>
    <MobileMenuButton />
  </div>
</BaseLayout>

<style is:global>
  .mermaid {
    display: flex;
    justify-content: center;
    margin: 1.5em 0;
    max-width: 100%;
    overflow-x: auto;
  }
  .mermaid svg {
    max-width: 100%;
    height: auto;
  }
  /* Prevent prose typography styles from interfering with Mermaid SVGs */
  .prose .mermaid text {
    font-size: inherit;
    line-height: normal;
    color: inherit;
  }
  .prose .mermaid a {
    text-decoration: none;
    color: inherit;
  }
  .prose .mermaid pre,
  .prose .mermaid code {
    background: none;
    padding: 0;
    border: 0;
    font-size: inherit;
  }
</style>

<script>
  const copyIcon = `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 010 1.5h-1.5a.25.25 0 00-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 00.25-.25v-1.5a.75.75 0 011.5 0v1.5A1.75 1.75 0 019.25 16h-7.5A1.75 1.75 0 010 14.25v-7.5z"/><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0114.25 11h-7.5A1.75 1.75 0 015 9.25v-7.5zm1.75-.25a.25.25 0 00-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 00.25-.25v-7.5a.25.25 0 00-.25-.25h-7.5z"/></svg>`;
  const checkIcon = `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg>`;

  document.querySelectorAll('article pre:not(.mermaid)').forEach((pre) => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.setAttribute('aria-label', 'Copy code');
    btn.innerHTML = copyIcon;

    btn.addEventListener('click', () => {
      const code = pre.querySelector('code');
      if (!code) return;
      navigator.clipboard.writeText(code.textContent || '').then(() => {
        btn.classList.add('copied');
        btn.innerHTML = checkIcon;
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = copyIcon;
        }, 2000);
      });
    });

    pre.appendChild(btn);
  });
</script>
