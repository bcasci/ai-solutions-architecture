---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileMenuButton from '../components/MobileMenuButton.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

const docs = await getCollection('docs', ({ data }) => !data.draft);

const sectionMeta = [
  { key: 'start-here', label: 'Start Here', description: 'Get up and running with Claude in 60 seconds.' },
  { key: 'the-api', label: 'The API', description: 'Request mechanics — models, messages, streaming, multimodal input, and tool use.' },
  { key: 'prompting', label: 'Prompting', description: 'Prompt engineering — system prompts, structured output, evaluation, and extraction.' },
  { key: 'retrieval', label: 'RAG (Retrieval Augmented Generation)', description: 'Give Claude knowledge it doesn\'t have — chunking, embeddings, and RAG pipelines.' },
  { key: 'agents', label: 'Agents', description: 'Orchestration patterns, autonomous agent loops, and multi-agent systems.' },
  { key: 'claude-code', label: 'Claude Code', description: 'Set up, configure, and extend your terminal-based coding assistant.' },
  { key: 'mcp', label: 'MCP', description: 'Model Context Protocol — the standard for connecting Claude to external tools and data.' },
  { key: 'production', label: 'Production', description: 'Ship reliably at scale.' },
  { key: 'recipes', label: 'Recipes', description: 'Copy-paste solutions for common tasks.' },
  { key: 'reference', label: 'Reference', description: 'Quick lookups and external resources.' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = sectionMeta.map((meta) => ({
  ...meta,
  pages: docs
    .filter((d) => d.data.section === meta.key)
    .sort((a, b) => a.data.order - b.data.order),
})).filter((s) => s.pages.length > 0);
---

<BaseLayout title={`${SITE.title} — ${SITE.author}`} canonicalPath="/">
  <div class="flex min-h-screen">
    <Sidebar />
    <main class="min-w-0 flex-1">
      <!-- Hero -->
      <div class="relative overflow-hidden bg-gray-950 px-8 py-20 lg:px-12">
        <!-- Interconnected Claude sparkles -->
        <svg class="absolute right-0 top-0 h-full w-2/3 opacity-[0.14]" viewBox="0 0 600 400" fill="none">
          <!-- Connection lines between sparkles -->
          <line x1="400" y1="90" x2="520" y2="150" stroke="rgb(129,140,248)" stroke-width="1" />
          <line x1="400" y1="90" x2="320" y2="200" stroke="rgb(129,140,248)" stroke-width="0.7" />
          <line x1="520" y1="150" x2="460" y2="260" stroke="rgb(129,140,248)" stroke-width="0.7" />
          <line x1="320" y1="200" x2="460" y2="260" stroke="rgb(129,140,248)" stroke-width="0.5" />
          <line x1="320" y1="200" x2="280" y2="320" stroke="rgb(129,140,248)" stroke-width="0.5" />
          <line x1="460" y1="260" x2="380" y2="350" stroke="rgb(129,140,248)" stroke-width="0.7" />
          <line x1="280" y1="320" x2="380" y2="350" stroke="rgb(129,140,248)" stroke-width="0.5" />
          <line x1="520" y1="150" x2="550" y2="310" stroke="rgb(129,140,248)" stroke-width="0.5" />
          <line x1="550" y1="310" x2="380" y2="350" stroke="rgb(129,140,248)" stroke-width="0.5" />
          <line x1="230" y1="120" x2="400" y2="90" stroke="rgb(129,140,248)" stroke-width="0.5" />
          <line x1="230" y1="120" x2="320" y2="200" stroke="rgb(129,140,248)" stroke-width="0.5" />
          <!-- Mini Claude sparkles at each node -->
          <g fill="rgb(129,140,248)" transform="translate(400,90)">
            <path d="M0-14C0-14 1.8-5.2 0 0C-1.8-5.2 0-14 0-14Z"/>
            <path d="M0 14C0 14-1.8 5.2 0 0C1.8 5.2 0 14 0 14Z"/>
            <path d="M-14 0C-14 0-5.2-1.8 0 0C-5.2 1.8-14 0-14 0Z"/>
            <path d="M14 0C14 0 5.2 1.8 0 0C5.2-1.8 14 0 14 0Z"/>
            <circle r="2"/>
          </g>
          <g fill="rgb(129,140,248)" transform="translate(520,150)" opacity="0.8">
            <path d="M0-10C0-10 1.3-3.7 0 0C-1.3-3.7 0-10 0-10Z"/>
            <path d="M0 10C0 10-1.3 3.7 0 0C1.3 3.7 0 10 0 10Z"/>
            <path d="M-10 0C-10 0-3.7-1.3 0 0C-3.7 1.3-10 0-10 0Z"/>
            <path d="M10 0C10 0 3.7 1.3 0 0C3.7-1.3 10 0 10 0Z"/>
            <circle r="1.5"/>
          </g>
          <g fill="rgb(129,140,248)" transform="translate(320,200)">
            <path d="M0-16C0-16 2-6 0 0C-2-6 0-16 0-16Z"/>
            <path d="M0 16C0 16-2 6 0 0C2 6 0 16 0 16Z"/>
            <path d="M-16 0C-16 0-6-2 0 0C-6 2-16 0-16 0Z"/>
            <path d="M16 0C16 0 6 2 0 0C6-2 16 0 16 0Z"/>
            <path d="M-11-11C-11-11-4-7 0 0C-7-4-11-11-11-11Z"/>
            <path d="M11 11C11 11 4 7 0 0C7 4 11 11 11 11Z"/>
            <path d="M11-11C11-11 7-4 0 0C4-7 11-11 11-11Z"/>
            <path d="M-11 11C-11 11-7 4 0 0C-4 7-11 11-11 11Z"/>
            <circle r="2.5"/>
          </g>
          <g fill="rgb(129,140,248)" transform="translate(460,260)" opacity="0.7">
            <path d="M0-11C0-11 1.4-4 0 0C-1.4-4 0-11 0-11Z"/>
            <path d="M0 11C0 11-1.4 4 0 0C1.4 4 0 11 0 11Z"/>
            <path d="M-11 0C-11 0-4-1.4 0 0C-4 1.4-11 0-11 0Z"/>
            <path d="M11 0C11 0 4 1.4 0 0C4-1.4 11 0 11 0Z"/>
            <circle r="1.8"/>
          </g>
          <g fill="rgb(129,140,248)" transform="translate(280,320)" opacity="0.5">
            <path d="M0-8C0-8 1-3 0 0C-1-3 0-8 0-8Z"/>
            <path d="M0 8C0 8-1 3 0 0C1 3 0 8 0 8Z"/>
            <path d="M-8 0C-8 0-3-1 0 0C-3 1-8 0-8 0Z"/>
            <path d="M8 0C8 0 3 1 0 0C3-1 8 0 8 0Z"/>
            <circle r="1.3"/>
          </g>
          <g fill="rgb(129,140,248)" transform="translate(380,350)" opacity="0.6">
            <path d="M0-12C0-12 1.5-4.5 0 0C-1.5-4.5 0-12 0-12Z"/>
            <path d="M0 12C0 12-1.5 4.5 0 0C1.5 4.5 0 12 0 12Z"/>
            <path d="M-12 0C-12 0-4.5-1.5 0 0C-4.5 1.5-12 0-12 0Z"/>
            <path d="M12 0C12 0 4.5 1.5 0 0C4.5-1.5 12 0 12 0Z"/>
            <circle r="2"/>
          </g>
          <g fill="rgb(129,140,248)" transform="translate(550,310)" opacity="0.4">
            <path d="M0-7C0-7 0.9-2.6 0 0C-0.9-2.6 0-7 0-7Z"/>
            <path d="M0 7C0 7-0.9 2.6 0 0C0.9 2.6 0 7 0 7Z"/>
            <path d="M-7 0C-7 0-2.6-0.9 0 0C-2.6 0.9-7 0-7 0Z"/>
            <path d="M7 0C7 0 2.6 0.9 0 0C2.6-0.9 7 0 7 0Z"/>
            <circle r="1"/>
          </g>
          <g fill="rgb(129,140,248)" transform="translate(230,120)" opacity="0.4">
            <path d="M0-6C0-6 0.8-2.2 0 0C-0.8-2.2 0-6 0-6Z"/>
            <path d="M0 6C0 6-0.8 2.2 0 0C0.8 2.2 0 6 0 6Z"/>
            <path d="M-6 0C-6 0-2.2-0.8 0 0C-2.2 0.8-6 0-6 0Z"/>
            <path d="M6 0C6 0 2.2 0.8 0 0C2.2-0.8 6 0 6 0Z"/>
            <circle r="1"/>
          </g>
        </svg>
        <div class="relative max-w-2xl">
          <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
            Building with Claude
          </h1>
          <p class="mt-4 text-lg text-gray-400">
            Patterns, code, and practical guidance for building with Anthropic's Claude.
            No lectures — just what works.
          </p>
          {sections.length > 0 && sections[0].pages.length > 0 && (
            <a
              href={`${base}/${sections[0].pages[0].id}`}
              class="mt-8 inline-flex items-center gap-2 rounded-lg bg-indigo-500 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-indigo-400 hover:shadow-lg hover:shadow-indigo-500/25"
            >
              Get started
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor">
                <path d="M6.22 3.22a.75.75 0 011.06 0l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 010-1.06z" />
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Hero-to-content gradient transition -->
      <div class="h-px bg-gradient-to-r from-transparent via-indigo-500/20 to-transparent"></div>

      <!-- Section Index -->
      <div class="mx-auto max-w-4xl px-8 py-16 lg:px-12">
        <div class="grid gap-6 sm:grid-cols-2">
          {sections.map((section) => (
            <a
              href={`${base}/${section.pages[0].id}`}
              class="group rounded-xl border border-gray-200/80 bg-white p-5 no-underline transition-all hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md hover:shadow-indigo-500/5 dark:border-gray-800/80 dark:bg-gray-900/50 dark:hover:border-indigo-600 dark:hover:shadow-indigo-500/5"
            >
              <h2 class="text-sm font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
                {section.label}
              </h2>
              <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">{section.description}</p>
              <ul class="mt-3 space-y-0.5">
                {section.pages.map((page) => (
                  <li class="text-sm text-gray-600 dark:text-gray-400">
                    {page.data.title}
                  </li>
                ))}
              </ul>
            </a>
          ))}
        </div>
      </div>
      <Footer />
    </main>
    <MobileMenuButton />
  </div>
</BaseLayout>
